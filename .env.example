# Scripts read this file from the REPO ROOT.
# (The original investigation kept it one level up and scripts reference "../.env" —
#  either move this to ../ or change the dotenv_values path in the script you run.)

# Required for almost everything (transaction history). Free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Required for on-chain state reads (eth_call / eth_getBalance / eth_getCode).
# Any mainnet RPC. Free Alchemy/Infura work for single calls (NOT eth_getLogs / batching).
RPC_URL=

# Optional — only used by a couple of early scripts.
DUNE_API_KEY=
TENDERLY_ACCESS_KEY=
